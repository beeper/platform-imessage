{
  "name": "@beeper/platform-imessage",
  "version": "0.20.3",
  "main": "dist/index.js",
  "type": "module",
  "exports": {
    "./*": "./dist/*.js",
    "./auth": "./dist/auth/index.js",
    "./info": "./dist/info.js",
    "./capabilities": "./dist/capabilities.js",
    ".": "./dist/index.js"
  },
  "files": [
    "dist/**/*",
    "binaries/**/*"
  ],
  "scripts": {
    "dev": "concurrently -P 'yarn build:scss --watch' 'yarn build:typescript --watch' 'yarn build:swift --debug --watch {@}'",
    "prepack": "yarn build",
    "lint:swift": "swiftlint --fix --format src",
    "lint": "yarn eslint src --ext ts,tsx,js,jsx --cache",
    "messages-controller-cli": "env NODE_OPTIONS=\"--force-node-api-uncaught-exceptions-policy=true\" electron messages-controller-cli.compiled.mjs",
    "cli": "env NODE_OPTIONS=\"--force-node-api-uncaught-exceptions-policy=true\" electron cli.compiled.mjs",
    "rebuild:native": "npx @electron/rebuild -v 41.2.1 -f -w better-sqlite3",
    "build:messages-controller-cli": "bun build src/cli/messages-controller/index.ts --target=node --format=esm --external electron --outfile=messages-controller-cli.compiled.mjs",
    "build:cli": "bun build src/cli/index.ts --target=node --format=esm --external electron --external @textshq/platform-test-lib --external node-mac-permissions --outfile=cli.compiled.mjs",
    "build": "turbo run build:swift build:typescript build:scss",
    "build:scss": "sass -s compressed --no-source-map src/auth/auth.scss binaries/imessage-auth.css",
    "build:typescript": "tsc",
    "build:swift": "node --loader ts-node/esm src/SwiftServer/build-swift.ts",
    "typecheck": "tsc --noEmit",
    "hackily-install-binaries": "mv /Applications/Texts.app/Contents/Resources/app/build/platform-imessage{,-old}; ln -fs ${PWD}/binaries /Applications/Texts.app/Contents/Resources/app/build/platform-imessage"
  },
  "dependencies": {
    "@textshq/platform-sdk": "https://github.com/TextsHQ/platform-sdk#450f733b0d496b793ae6cab273759a1246ee6053",
    "clsx": "^1.2.1",
    "concurrently": "^9.1.2",
    "crc": "^4.1.1",
    "lodash": "^4.17.21",
    "url-regex": "^5.0.0"
  },
  "devDependencies": {
    "@jxa/global-type": "^1.3.5",
    "@sentry/cli": "^2.50.2",
    "@textshq/eslint-config": "https://github.com/TextsHQ/eslint-config#main",
    "@textshq/platform-test-lib": "https://github.com/TextsHQ/platform-test-lib#main",
    "@types/eslint": "^8.4.10",
    "@types/jest": "^28.1.6",
    "@types/lodash": "^4.14.182",
    "@types/node": "20.17.19",
    "@types/react": "^17.0.38",
    "ansi-colors": "^4.1.3",
    "electron": "^41.2.1",
    "eslint": "^8.30.0",
    "jest": "^28.1.3",
    "node-gyp": "^11.0.0",
    "node-mac-permissions": "TextsHQ/node-mac-permissions.git",
    "node-swift": "https://github.com/kabiroberai/node-swift#2c1db896c643f2a9e6bebd9a45d2703ae5f69b71",
    "p-queue": "^8",
    "p-retry": "^6",
    "react": "^18",
    "sass": "^1.76.0",
    "ts-jest": "^28.0.7",
    "ts-node": "^10.9.2",
    "turbo": "2.5.8",
    "typescript": "^5.8.3",
    "zod": "^4.0.17"
  },
  "os": [
    "darwin"
  ],
  "resolutions": {
    "@textshq/platform-sdk": "https://github.com/TextsHQ/platform-sdk#450f733b0d496b793ae6cab273759a1246ee6053",
    "node-gyp": "^10.0.1"
  },
  "peerDependencies": {
    "node-mac-permissions": "*",
    "p-queue": "^8",
    "p-retry": "^6",
    "react": "*"
  },
  "packageManager": "yarn@4.14.1"
}
