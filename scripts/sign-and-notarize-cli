#!/usr/bin/env bash

set -euo pipefail

team_id="PZYM8XX95Q"
arch="universal"

usage() {
  printf "usage: %s [--arch arm64|x86_64|universal] [--team-id TEAM_ID]\n" "${0##*/}"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --arch)
      if [ $# -lt 2 ]; then
        printf >&2 "missing value for --arch\n"
        usage >&2
        exit 1
      fi
      arch="$2"
      shift 2
      ;;
    --team-id)
      if [ $# -lt 2 ]; then
        printf >&2 "missing value for --team-id\n"
        usage >&2
        exit 1
      fi
      team_id="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      printf >&2 "unknown arg: %s\n" "$1"
      usage >&2
      exit 1
      ;;
  esac
done

case "$arch" in
  arm64|x86_64|universal) ;;
  *)
    printf >&2 "invalid --arch: %s (expected: arm64, x86_64, universal)\n" "$arch"
    exit 1
    ;;
esac

# Signing and notarization are delegated to the a8c-ci-toolkit `sign_and_notarize`
# command, which the toolkit Buildkite plugin puts on PATH. The Developer ID cert
# must already be in the keychain (release-cli.sh runs `fastlane set_up_signing`).
if ! command -v sign_and_notarize >/dev/null 2>&1; then
  printf >&2 "sign_and_notarize not on PATH (provided by the a8c-ci-toolkit plugin)\n"
  exit 1
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

entitlements="$repo_root/scripts/imessage-cli.entitlements"
cli_swift_flags=(-Xswiftc -DIMESSAGE_DISABLE_PRIVATE_SPI_ASSETS)

build_arch() {
  local target_arch="$1"
  printf "==> building %s\n" "$target_arch"
  swift build -c release --triple "${target_arch}-apple-macosx11" --product imessage-cli "${cli_swift_flags[@]}"
}

bin_for_arch() {
  swift build -c release --triple "${1}-apple-macosx11" --product imessage-cli "${cli_swift_flags[@]}" --show-bin-path
}

if [ "$arch" = "universal" ]; then
  build_arch arm64
  build_arch x86_64
  arm64_bin="$(bin_for_arch arm64)/imessage-cli"
  x86_bin="$(bin_for_arch x86_64)/imessage-cli"
  out_dir="$repo_root/.build/universal/release"
  mkdir -p "$out_dir"
  binary="$out_dir/imessage-cli"
  printf "==> creating universal binary\n"
  lipo -create "$arm64_bin" "$x86_bin" -output "$binary"
else
  build_arch "$arch"
  binary="$(bin_for_arch "$arch")/imessage-cli"
fi

printf "==> stripping debug symbols\n"
# strip must happen before signing — stripping invalidates an existing
# signature, and the release asset shrinks meaningfully without it
strip "$binary"

sign_and_notarize --team-id "$team_id" --entitlements "$entitlements" "$binary"

printf "==> signed binary at: %s\n" "$binary"
